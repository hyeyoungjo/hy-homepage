---
import type { CollectionEntry } from 'astro:content';
import YouTubeEmbed from '../components/YouTubeEmbed.astro';
import LinkRow from '../components/LinkRow.astro';
import CiteBlock from '../components/CiteBlock.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const d = project.data;
---

<article class="project container">
  <header class="prose">
    <a class="project__back" href="/work">← Back</a>
    <p class="project__type">{d.type}{d.year ? ` · ${d.year}` : ''}</p>
    <h1>{d.title}</h1>
    {
      d.authors.length > 0 && (
        <p class="project__authors">
          {d.authors.map((a, i) => (
            <>
              {i > 0 ? ', ' : ''}
              {a.replace(/\*+$/, '').trim() === 'Hye-Young Jo' ? <strong>{a}</strong> : a}
            </>
          ))}
        </p>
      )
    }
    {d.authors.some((a) => a.trim().endsWith('*')) && (
      <p class="project__authors-note">* Equal contribution</p>
    )}
    {
      d.venue && (
        <p class="project__venue">
          {d.venue}
          {d.acceptanceRate ? ` · Acceptance ${d.acceptanceRate}` : ''}
        </p>
      )
    }
    {d.award && <p class="project__award">{d.award}</p>}
    <LinkRow links={d.links} originalLink={d.originalLink} hasExtra={Boolean(d.bibtex)}>
      <CiteBlock bibtex={d.bibtex} endnote={d.endnote} acmref={d.acmref} />
    </LinkRow>
  </header>

  {d.abstract && <p class="project__abstract prose">{d.abstract}</p>}

  {/* a short teaser, when there is one, is the embedded video; the full video stays a button */}
  {(d.links.teaser ?? d.links.youtube) && <div class="prose"><YouTubeEmbed url={(d.links.teaser ?? d.links.youtube)!} title={d.title} /></div>}

  <div class="prose project__body">
    <slot />
  </div>
</article>

<script>
  // Looping clips: one pause/play button each, and no autoplay for people who
  // ask their system for reduced motion.
  const PAUSE = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5h4v14H6zM14 5h4v14h-4z"/></svg>';
  const PLAY = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4l13 8-13 8z"/></svg>';
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLButtonElement>('[data-loop-toggle]').forEach((btn) => {
    const video = btn.parentElement?.querySelector('video');
    if (!video) return;
    const sync = () => {
      const playing = !video.paused;
      btn.innerHTML = playing ? PAUSE : PLAY;
      btn.setAttribute('aria-label', playing ? 'Pause animation' : 'Play animation');
    };
    if (reduce) {
      video.removeAttribute('autoplay');
      video.pause();
    }
    btn.addEventListener('click', () => (video.paused ? video.play() : video.pause()));
    video.addEventListener('play', sync);
    video.addEventListener('pause', sync);
    sync();
  });
</script>
