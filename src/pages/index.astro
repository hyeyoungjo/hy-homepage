---
import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Timeline from '../components/Timeline.astro';
import { byNewest } from '../lib/site';

type Project = CollectionEntry<'projects'>;

// The home page is curated: one row per field, each showing only the pieces
// marked `featured`, in their `order`. Everything else lives on /work.
// A newest-first row would bury film and art under the latest papers.
const featured = await getCollection('projects', ({ data }) => data.featured && !data.draft);

const byOrder = (a: Project, b: Project) =>
  (a.data.order ?? Infinity) - (b.data.order ?? Infinity) || byNewest(a, b);

// Row anchors match the section ids on /work.
const ROWS: { title: string; type: Project['data']['type']; href: string }[] = [
  { title: 'Research', type: 'research', href: '/work#research' },
  { title: 'Film', type: 'film', href: '/work#film' },
  { title: 'Artwork', type: 'art', href: '/work#artwork' },
];

const rows = ROWS.map((r) => ({
  ...r,
  items: featured.filter((p) => p.data.type === r.type).sort(byOrder).slice(0, 4),
})).filter((r) => r.items.length > 0);

// Solo pieces (most artwork) skip the author line: a lone "Hye-Young Jo"
// under every painting says nothing the page does not already say.
const hasCoauthors = (p: Project) =>
  p.data.authors.some((a) => a.replace(/\*+$/, '').trim() !== 'Hye-Young Jo');

// First sentence of the abstract, so the caption stays one or two lines.
const gist = (abstract?: string) => abstract?.split(/(?<=\.)\s/)[0] ?? '';
---

<BaseLayout>
  <Hero />
  <Timeline />

  <section class="selected container section">
    <h2 class="selected__title">Selected Work</h2>
    {
      rows.map((row) => (
        <div class="recent">
          <div class="recent__head">
            <h3>{row.title}</h3>
            <a href={row.href}>All {row.title.toLowerCase()} →</a>
          </div>
          <div class="recent__row">
            {row.items.map((p) => (
              <figure class="recent__item">
                <a href={`/${p.id}`}>
                  {p.data.teaser && (
                    <Image
                      src={p.data.teaser}
                      alt={p.data.teaserAlt ?? p.data.title}
                      widths={[320, 640]}
                      sizes="(max-width: 900px) 50vw, 300px"
                    />
                  )}
                </a>
                <figcaption>
                  <a href={`/${p.id}`}>{p.data.title}</a>
                  {hasCoauthors(p) && (
                    <span class="recent__authors">
                      {p.data.authors.map((a, i) => (
                        <>
                          {i > 0 ? ', ' : ''}
                          {a.replace(/\*+$/, '').trim() === 'Hye-Young Jo' ? <strong>{a}</strong> : a}
                        </>
                      ))}
                    </span>
                  )}
                  <span>{gist(p.data.abstract)}</span>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      ))
    }
  </section>
</BaseLayout>

<style>
  .selected.section { padding-top: 1.1rem; }
  .selected__title { font-size: var(--section-title); margin: 0 0 1.25rem; }

  .recent + .recent { margin-top: 2.25rem; }

  .recent__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 1.1rem;
  }
  .recent__head h3 { font-size: 1.05rem; font-weight: 600; margin: 0; }
  .recent__head a { font-size: 0.9rem; }

  .recent__row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .recent__item { margin: 0; }
  .recent__item img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    display: block;
    border-radius: var(--thumb-radius);
    background: var(--color-code-bg);
  }
  .recent__item figcaption { margin-top: 0.55rem; font-size: 0.95rem; }
  .recent__item figcaption a { color: var(--color-fg); font-weight: 600; }
  .recent__item figcaption span {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--color-muted);
  }
  /* Authors sit between the title and the gist, a step darker than the gist */
  .recent__item figcaption .recent__authors { font-size: 0.8rem; color: var(--color-soft); }
  .recent__authors strong { font-weight: 600; white-space: nowrap; }

  @media (max-width: 900px) {
    .recent__row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 520px) {
    .recent__row { grid-template-columns: minmax(0, 1fr); }
  }
</style>
