const links = [
  { label: 'Email', href: `mailto:${SITE.email}`, icon: ICONS.email, copy: SITE.email },
  { label: 'CV', href: SITE.cv, icon: ICONS.cv },
  { label: 'Scholar', href: SITE.socials.scholar, icon: ICONS.scholar },
  { label: 'GitHub', href: SITE.socials.github, icon: ICONS.github },
  { label: 'LinkedIn', href: SITE.socials.linkedin, icon: ICONS.linkedin },
  { label: 'Twitter', href: SITE.socials.x, icon: ICONS.x },
  { label: 'IMDb', href: SITE.socials.imdb, icon: ICONS.imdb },
  { label: 'Instagram', href: SITE.socials.instagram, icon: ICONS.instagram },
];
---

<div class="socials">
  {
    links.map((l) => (
      <a
        href={l.href}
        target={l.href.startsWith('mailto') ? undefined : '_blank'}
        rel="noopener"
        data-copy={l.copy}
      >
        <svg
          class="social__icon"
          viewBox="0 0 24 24"
          width="15"
          height="15"
          fill="currentColor"
          aria-hidden="true"
          set:html={l.icon}
        />
        <span>{l.label}</span>
      </a>
    ))
  }
</div>

<script>
  // The email link copies the address rather than handing off to a mail client,
  // which is what most visitors actually want. The mailto: href stays put so
  // "open link" and "copy link" still work from the context menu.
  document.querySelectorAll<HTMLAnchorElement>('.socials a[data-copy]').forEach((a) => {
    const address = a.dataset.copy;
    const label = a.querySelector('span');
    if (!address || !label) return;

    a.addEventListener('click', async (e) => {
      e.preventDefault();
      try {
        await navigator.clipboard.writeText(address);
        label.textContent = 'Copied';
        a.classList.add('is-done');
        setTimeout(() => {
          label.textContent = 'Email';
          a.classList.remove('is-done');
        }, 1600);
      } catch {
        window.location.href = a.href;
      }
    });
  });
</script>
